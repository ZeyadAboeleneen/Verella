# Copy this file to .env (repo root) for Docker Compose + `pnpm db:*` scripts,
# AND to apps/web/.env.local for `pnpm dev` (Next.js only reads env files from
# its own app directory, not the monorepo root — see docs/SETUP.md).
# NEVER commit the real .env / .env.local files.

# ── Database ────────────────────────────────────────────────────────────────
# Local/non-Docker dev: mysql://verella:changeme@localhost:3306/verella
# Inside Docker Compose: host is the service name, not localhost.
DATABASE_URL=mysql://verella:changeme@mysql:3306/verella

# Used by docker-compose.yml to initialize the MySQL container.
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=verella
MYSQL_USER=verella
MYSQL_PASSWORD=changeme

# ── Object storage (Cloudinary) ─────────────────────────────────────────────
# From your Cloudinary dashboard: Settings → API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Legacy object storage (S3-compatible) — no longer used by the app or by
# docker-compose.yml (the minio service has been removed). Kept only so the
# one-off `migrate-media-to-cloudinary` script can pick up and migrate any
# objects if you point it at a real S3-compatible instance. Safe to remove
# entirely once you've confirmed the Cloudinary migration.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://your-domain.example.com/s3
S3_PUBLIC_MEDIA_BASE_URL=https://your-domain.example.com/media
S3_ACCESS_KEY_ID=verella-minio
S3_SECRET_ACCESS_KEY=changeme-minio-password
S3_PUBLIC_BUCKET=verella-public
S3_PRIVATE_BUCKET=verella-private
MINIO_USE_SSL=true
MINIO_PUBLIC_HOSTNAME=your-domain.example.com

# ── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=replace-with-a-real-random-secret
AUTH_URL=https://your-domain.example.com
# Local dev override:
# AUTH_URL=http://localhost:3000

# ── Email (password reset) ─────────────────────────────────────────────────
# Optional. When SMTP_URL is set, password-reset emails are sent for real.
# When it's empty, the reset flow still works but the reset LINK is printed to
# the server console instead of emailed (fine for local dev). See
# apps/web/src/lib/email/mailer.ts.
# SMTP_URL=smtp://user:pass@smtp.your-host.com:587
# EMAIL_FROM=Verella <no-reply@your-domain.com>

# ── Seed script (packages/db/src/seed.ts) ──────────────────────────────────
# First Super Admin account created on first `pnpm db:seed`. CHANGE THE
# PASSWORD immediately after first login — see docs/SETUP.md.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

NODE_ENV=development
