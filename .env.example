# Verella environment template.
#
#   Production (Docker):  copy to .env at the repo root, fill in every value,
#                         then run compose with --env-file ../.env (docs/SETUP.md).
#   Local development:    copy to .env (for `pnpm db:*`) AND apps/web/.env.local
#                         (Next.js only reads env files from its own app folder).
#
# NEVER commit the real .env / .env.local files. Do NOT set NODE_ENV here —
# Next.js and the Docker image set it themselves.

# ── Domain & HTTPS (production) ─────────────────────────────────────────────
# Caddy (docker/Caddyfile) fetches the TLS certificate for this domain and
# redirects http → https. DNS for DOMAIN and www.DOMAIN must point at the server.
DOMAIN=verella.com
ACME_EMAIL=verellabrands@gmail.com

# ── Database ────────────────────────────────────────────────────────────────
# Inside Docker Compose the host is the service name "mysql".
# Local dev: mysql://root@127.0.0.1:3306/verella
DATABASE_URL=mysql://verella:CHANGE-ME-db-password@mysql:3306/verella

# Used by docker-compose.yml to initialise the MySQL container.
# Must match the user/password in DATABASE_URL.
MYSQL_ROOT_PASSWORD=CHANGE-ME-root-password
MYSQL_DATABASE=verella
MYSQL_USER=verella
MYSQL_PASSWORD=CHANGE-ME-db-password

# ── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 33   (a new one per environment)
AUTH_SECRET=replace-with-a-real-random-secret
# The public https URL. Also used for sitemap, canonical URLs and email links.
AUTH_URL=https://verella.com
# Behind Caddy the app sees plain http from the proxy — trust its Host header.
AUTH_TRUST_HOST=true

# ── Media (Cloudinary) ──────────────────────────────────────────────────────
# Cloudinary dashboard → Settings → API Keys. Product photos and payment
# screenshots can't be uploaded until these are set.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email ───────────────────────────────────────────────────────────────────
# Order confirmations, admin order alerts, contact form, password reset and
# email verification. Without SMTP_URL, emails are printed to the server log
# instead of being sent (fine locally, NOT for production).
# SMTP_URL=smtps://user:password@smtp.your-provider.com:465
# EMAIL_FROM=Verella <no-reply@verella.com>

# ── Analytics (optional) ────────────────────────────────────────────────────
# GA4 measurement ID. Loaded only for visitors who accept analytics cookies.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── First seed (packages/db/src/seed.ts) ───────────────────────────────────
# The super-admin account created on the very first seed. On a non-local
# database the seed refuses to run unless the password is 12+ characters.
SEED_ADMIN_EMAIL=verellabrands@gmail.com
SEED_ADMIN_PASSWORD=
# Demo products with placeholder photos — leave false in production.
SEED_DEMO_CATALOG=false
